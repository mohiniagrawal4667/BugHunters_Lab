# Frontend (Vite)
# Optional: leave unset in dev (Vite /api proxy) or same-origin Vercel deployment (/api/*).
# Set to your deployed backend origin (e.g. https://your-backend.onrender.com) when hosting frontend & backend separately.
# VITE_API_BASE_URL=

# Backend (FastAPI)
BHL_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://bughunterslab.vercel.app
# Optional comma-separated non-standard ports (default allows only 80 for HTTP and 443 for HTTPS)
BHL_EXTRA_ALLOWED_PORTS=
BHL_REQUEST_TIMEOUT=10.0
BHL_CONNECT_TIMEOUT=5.0
BHL_MAX_RESPONSE_BYTES=2097152
BHL_MAX_REDIRECTS=5
BHL_MIN_REQUEST_INTERVAL=0.15
BHL_MAX_REQUESTS_PER_SCAN=25
# Optional SQLite database file override (defaults to backend/data/bughunterlab.db)
BHL_DB_PATH=backend/data/bughunterlab.db
